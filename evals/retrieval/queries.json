    {
      "id": "declared-scope-money",
      "class": "declared",
      "query": "adjust rounding behaviour",
      "declared": ["packages/core/src/utils/money.mjs"],
      "primary": "packages/core/src/utils/money.mjs",
      "expect": ["packages/core/src/utils/money.mjs"]
