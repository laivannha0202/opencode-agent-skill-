      "expect": ["packages/core/src/utils/money.mjs"]
    },
    {
      "id": "monorepo-api-handler-entry",
      "class": "monorepo-local",
      "query": "apps/api http entry point",
      "primary": "apps/api/src/handlers.mjs",
      "expect": ["apps/api/src/handlers.mjs", "apps/api/src/checkout.mjs"]
