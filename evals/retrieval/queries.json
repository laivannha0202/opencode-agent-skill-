      "primary": "packages/billing/src/tax.mjs",
      "expect": ["packages/billing/src/tax.mjs"]
    },
    {
      "id": "exact-symbol-refunds",
      "class": "exact-symbol",
      "query": "refundInvoice",
      "primary": "packages/billing/src/refunds.mjs",
      "expect": ["packages/billing/src/refunds.mjs"]
