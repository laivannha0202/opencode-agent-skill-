      "changed": ["packages/core/src/orders.mjs"],
      "expect": ["packages/core/src/orders.mjs", "packages/core/src/pricing.mjs"]
    },
    {
      "id": "changed-file-telemetry-leak",
      "class": "changed-file-bug",
