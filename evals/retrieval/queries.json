{
  "schemaVersion": 1,
  "kind": "ues-retrieval-queries",
  "note": "Deterministic repo-map retrieval fixtures. `expect` is the full set of relevant files for recall@K; `primary` is the single file that must rank first for MRR. `changed`/`declared` model the runtime signals a real task supplies. Every path must exist in evals/retrieval/fixture.mjs (asserted by test/repo-map.test.mjs).",
  "queries": [
    {
      "id": "exact-symbol-pricing",
      "class": "exact-symbol",
      "query": "calculateOrderTotal",
      "primary": "packages/core/src/pricing.mjs",
      "expect": ["packages/core/src/pricing.mjs"]
    },
    {
      "id": "exact-symbol-inventory",
      "class": "exact-symbol",
