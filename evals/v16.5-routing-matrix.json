      "ambiguous": true
    },
    {
      "id": "vietnamese-bug",
      "task": "Sửa lỗi đăng nhập bị lỗi sau khi cập nhật, nhanh giúp tôi tìm nguyên nhân",
      "expect": ["bug-diagnosis"],
      "language": "vi",
      "reject": ["documentation-engineering"]
    },
    {
      "id": "vietnamese-mixed",
      "task": "Fix lỗi race condition trong payment webhook (sửa lỗi implement mới)",
      "language": "mixed",
      "expect": ["payment-engineering"],
      "reject": ["documentation-engineering"]
    },
    {
      "id": "mixed-stack-payment-next",
      "task": "Next.js checkout page calls the payment API without idempotency key",
      "expect": ["payment-engineering", "nextjs-engineering"],
      "reject": ["documentation-engineering", "django-engineering"]
    },
    {
      "id": "mixed-stack-rn-auth",
      "task": "React Native OAuth callback fails token refresh in the auth screen",
