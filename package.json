{
  "name": "opencode-agent-skill",
  "version": "13.0.0-beta.3",
  "description": "Pi Agent engineering runtime with adaptive context, durable evidence, specialist child agents, and evidence-gated verification",
  "type": "module",
  "bin": {
    "ues": "bin/ocskill.mjs",
    "ocskill": "bin/ocskill.mjs"
  },
  "files": [
    "bin/ocskill.mjs",
    "lib/",
    "global-config/AGENTS.md",
    "global-config/skills/",
    "global-config/agents/",
    "global-config/commands/",
    "global-config/plugins/",
    "pi/",
    "scripts/",
    "evals/",
    "docs/PI-COMPAT.md",
    "docs/OPENCODE-COMPAT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "syntax": "node scripts/syntax-check.mjs",
    "test": "node --test",
    "test:pi": "node --test test/pi-package.test.mjs",
    "docs:check": "node scripts/check-release-consistency.mjs",
    "release:check-tag": "node scripts/check-release-tag.mjs",
    "smoke:pi": "node scripts/smoke-pi-extension.mjs",
    "smoke:package": "node scripts/smoke-package-closure.mjs",
    "eval:pi": "node scripts/eval-pi.mjs",
    "ci": "npm run syntax && npm test && npm run docs:check && npm pack --dry-run && npm run smoke:pi && npm run smoke:package",
    "prepublishOnly": "npm run ci",
    "smoke:packed": "node scripts/smoke-packed-install.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-agent",
    "agent-skills",
    "coding-agent",
    "developer-tools",
    "engineering-workflow",
    "code-review",
    "debugging",
    "verification",
    "multimodal-agents"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laivannha0202/opencode-agent-skill-.git"
  },
  "homepage": "https://github.com/laivannha0202/opencode-agent-skill-#readme",
  "bugs": {
    "url": "https://github.com/laivannha0202/opencode-agent-skill-/issues"
  },
  "license": "MIT",
  "pi": {
    "extensions": [
      "./pi/extensions/ues.ts"
    ],
    "skills": [
      "./global-config/skills"
    ],
    "prompts": [
      "./pi/prompts/*.md"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
