{
  "name": "@laivannha0202/opencode-agent-skill",
  "version": "2.0.0",
  "description": "Universal engineering agent skills pack for OpenCode with one-command npm installation",
  "type": "module",
  "bin": {
    "ocskill": "./bin/ocskill.mjs"
  },
  "files": [
    "bin",
    "lib",
    "global-config",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "validate": "node ./scripts/validate.mjs",
    "test": "node --test ./test/*.test.mjs",
    "ci": "npm run validate && npm test && npm pack --dry-run",
    "postinstall": "node ./bin/ocskill.mjs install --lifecycle",
    "preuninstall": "node ./bin/ocskill.mjs remove --lifecycle",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "opencode",
    "agent-skills",
    "coding-agent",
    "developer-tools",
    "react",
    "react-native",
    "dotnet",
    "java",
    "python"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laivannha0202/opencode-agent-skill-.git"
  },
  "homepage": "https://github.com/laivannha0202/opencode-agent-skill-#readme",
  "bugs": {
    "url": "https://github.com/laivannha0202/opencode-agent-skill-/issues"
  },
  "license": "MIT"
}
